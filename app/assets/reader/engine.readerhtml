<!DOCTYPE html>
<html lang="zh-Hans">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
<title>BookShelf</title>
<script>___BOOKSHELF_PDFJS___</script>
<script id="pdf-worker" type="text/plain">___BOOKSHELF_PDFWORKER___</script>
</head>
<body>
<div id="stage" class="booting">
  <div id="under" class="sheet"><div class="pad"><div id="under-html" class="prose"></div><div id="under-pdf" class="pdfwrap" hidden><canvas id="under-canvas"></canvas></div></div><div class="folio" id="under-folio"></div></div>
  <div id="leaf" class="sheet"><div class="pad"><div id="front-html" class="prose"></div><div id="front-pdf" class="pdfwrap" hidden><canvas id="front-canvas"></canvas></div></div><div class="folio" id="front-folio"></div><div id="edge-left" class="edge edge-left"></div><div id="edge-right" class="edge edge-right"></div></div>
  <div id="status" style="display:none">正在排版…</div>
</div>
<div id="measure"></div>
<style id="ink">
  :root {
    --paper: transparent;
    --ink: #3a2f24;
    --font: "PingFang SC", "PingFang TC", "Hiragino Sans GB", "Heiti SC", "STHeiti", "Yuanti SC", "Songti SC", "Songti TC", "STSong", "Source Han Serif SC", "Noto Serif CJK SC", "Noto Sans CJK SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
    --fs: 20px;
    --lh: 1.7;
    --align: justify;
    --margin: 22px;
    --track: 0.02em;
    --safe-top: 0px;
    --safe-right: 0px;
    --safe-bottom: 0px;
    --safe-left: 0px;
    /* Match READER_CHROME_TOP / READER_CHROME_BOTTOM in src/ui/insets.ts.
       iPhone 16e portrait safe area is about 59 top and 34 bottom; this clearance
       keeps the glass bars in the margin instead of on the glyphs. */
    --chrome-top: 46px;
    --chrome-bottom: 72px;
  }
  html, body {
    margin: 0; height: 100%;
    background: var(--paper, transparent);
    color: var(--ink, #3a2f24);
    overflow: hidden;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  #stage {
    position: relative; height: 100%; overflow: hidden;
    touch-action: none; user-select: none; -webkit-user-select: none;
    background: var(--paper, transparent);
  }
  #stage.booting .pad { opacity: 0; }
  #stage.shown .pad { opacity: 1; transition: opacity 180ms ease; }
  .sheet {
    position: absolute; inset: 0; background: var(--paper, transparent); color: var(--ink); overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }
  #leaf { z-index: 2; }
  #under { z-index: 1; }
  .edge { position: absolute; top: 0; bottom: 0; width: 28px; pointer-events: none; opacity: 0; }
  .edge-left { left: 0; background: linear-gradient(90deg, rgba(40, 24, 10, 0.18), rgba(40, 24, 10, 0)); }
  .edge-right { right: 0; background: linear-gradient(270deg, rgba(40, 24, 10, 0.18), rgba(40, 24, 10, 0)); }
  .pad {
    position: absolute;
    top: calc(var(--safe-top) + var(--chrome-top));
    right: calc(var(--safe-right) + var(--margin));
    bottom: calc(var(--safe-bottom) + var(--chrome-bottom));
    left: calc(var(--safe-left) + var(--margin));
    overflow: hidden;
  }
  .prose {
    font-size: var(--fs, 20px);
    line-height: var(--lh, 1.7);
    text-align: var(--align, justify);
    text-justify: inter-character;
    text-justify: inter-ideograph;
    letter-spacing: var(--track, 0.02em);
    font-family: var(--font);
    height: 100%;
    word-break: break-word;
    overflow-wrap: break-word;
    line-break: strict;
    text-spacing-trim: space-all;
    text-autospace: normal;
    font-kerning: normal;
    font-synthesis: none;
    font-variant-ligatures: common-ligatures;
    font-feature-settings: "kern" 1, "liga" 1, "calt" 1;
    -webkit-text-size-adjust: 100%;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }
  .prose.cjk { --track: 0.045em; }
  .vertical .prose.cjk { --track: 0.09em; }
  html.traditional .prose { font-variant-east-asian: traditional; }
  .prose { display: flow-root; }
  .prose, .prose * {
    font-family: var(--font) !important;
    color: var(--ink) !important;
    -webkit-text-fill-color: var(--ink) !important;
    letter-spacing: var(--track, 0.02em) !important;
    opacity: 1 !important;
    visibility: visible !important;
    text-shadow: none !important;
    max-width: 100% !important;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  #front-html, #under-html, #front-html *, #under-html * {
    float: none !important;
    position: static !important;
  }
  .prose p, .prose div, .prose li, .prose span, .prose a, .prose em, .prose strong, .prose b, .prose i, .prose font {
    line-height: var(--lh, 1.7) !important;
    text-align: var(--align, justify) !important;
    text-justify: inter-ideograph !important;
    font-size: 1em !important;
    white-space: normal !important;
  }
  .vertical, .vertical * { writing-mode: vertical-rl !important; text-orientation: mixed !important; }
  .vertical .folio { writing-mode: horizontal-tb !important; text-orientation: mixed !important; }
  .vertical .prose, .vertical .prose * { font-feature-settings: "kern" 1, "vert" 1, "vrt2" 1 !important; }
  .prose .para {
    text-indent: 0 !important;
    margin-block: 0 0.85em !important;
    margin-inline: 0 !important;
    padding: 0 !important;
  }
  .prose.cjk .para {
    text-indent: 2em !important;
    margin-block: 0 0.35em !important;
  }
  .prose .para-center {
    text-indent: 0 !important;
    text-align: center !important;
    margin-block: 0.35em !important;
    margin-inline: 0 !important;
    padding: 0 !important;
  }
  .prose.align-center .para,
  .prose.align-center.cjk .para { text-indent: 0 !important; }
  .vertical .prose.cjk .para { margin-block-end: 1em !important; }
  .prose h1, .prose h2, .prose h3, .prose h4 {
    text-indent: 0 !important;
    font-weight: 600 !important;
    line-height: 1.35 !important;
    margin-block: 0.2em 0.7em !important;
    margin-inline: 0 !important;
    padding: 0 !important;
  }
  .prose h1 {
    font-size: 1.32em !important;
    text-align: center !important;
    letter-spacing: 0.08em !important;
  }
  .prose h2 { font-size: 1.16em !important; letter-spacing: 0.05em !important; }
  .prose h3, .prose h4 { font-size: 1.06em !important; letter-spacing: 0.04em !important; }
  .prose blockquote {
    text-indent: 0 !important;
    margin-block: 0.45em !important;
    margin-inline: 0.2em !important;
    padding: 0 !important;
  }
  .prose img, .prose svg { max-width: 100% !important; max-height: 70% !important; object-fit: contain; }
  .folio {
    position: absolute; left: 0; right: 0;
    bottom: calc(var(--safe-bottom) + 8px);
    text-align: center; font-size: 11px; letter-spacing: 0.16em; opacity: 0.45;
    font-family: "PingFang SC", "Songti SC", "Iowan Old Style", Palatino, serif;
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }
  #measure { position: absolute; left: 0; top: 0; overflow: visible; visibility: hidden; pointer-events: none; z-index: -1; height: auto; }
  #measure.prose { position: absolute; height: auto; }
  #measure .probe { height: auto; display: flow-root; }
  .pdfwrap { height: 100%; display: flex; align-items: center; justify-content: center; }
  canvas { display: block; background: white; box-shadow: 0 10px 28px rgba(40, 24, 10, 0.14); border-radius: 1px; }
  #status {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-family: "PingFang SC", "Heiti SC", "Songti SC", serif;
    letter-spacing: 0.12em; opacity: 0.55; background: transparent;
  }
  .empty { opacity: 0.7; }
</style>
<script>
(function () {
  var CJK = '"PingFang SC", "PingFang TC", "Hiragino Sans GB", "Heiti SC", "STHeiti", "Yuanti SC", "Songti SC", "Songti TC", "STSong", "Noto Serif CJK SC", "Noto Sans CJK SC", "Noto Sans SC", "Microsoft YaHei", sans-serif';
  var FONTS = {
    system: '-apple-system, BlinkMacSystemFont, ' + CJK,
    pingfang: '"PingFang SC", "PingFang TC", "Hiragino Sans GB", "Noto Sans CJK SC", "Noto Sans SC", sans-serif',
    songti: '"Songti SC", "Songti TC", "STSong", "PMingLiU", "SimSun", "Source Han Serif SC", "Noto Serif CJK SC", "Noto Serif SC", serif',
    heiti: '"Heiti SC", "Heiti TC", "STHeiti", "SimHei", "PingFang SC", "Noto Sans CJK SC", "Noto Sans SC", sans-serif',
    kaiti: '"Kaiti SC", "Kaiti TC", "STKaiti", "KaiTi", "BiauKai", "Noto Serif CJK SC", serif',
    yuanti: '"Yuanti SC", "Yuanti TC", "PingFang SC", "Hiragino Maru Gothic ProN", "Noto Sans CJK SC", sans-serif'
  };
  var THEMES = {
    light: { paper: '#fbf9f4', ink: '#1d1d1f', deep: '#eceae4' },
    sepia: { paper: '#f4ecd8', ink: '#3a2f24', deep: '#e6dcc4' },
    dark: { paper: '#1c1c1e', ink: '#f0ebe3', deep: '#2a2622' }
  };
  var state = {
    kind: null,
    chapters: [],
    settings: readSettings(null),
    insets: { top: 0, right: 0, bottom: 0, left: 0 },
    chapter: 0,
    page: 0,
    cache: {},
    pdf: null,
    pdfBytes: null,
    pdfChunks: [],
    busy: false,
    coverSent: false
  };
  var stage = document.getElementById('stage');
  var leaf = document.getElementById('leaf');
  var under = document.getElementById('under');
  var edgeLeft = document.getElementById('edge-left');
  var edgeRight = document.getElementById('edge-right');
  var statusEl = document.getElementById('status');
  var measure = document.getElementById('measure');
  var frontHtml = document.getElementById('front-html');
  var underHtml = document.getElementById('under-html');
  var frontPdf = document.getElementById('front-pdf');
  var underPdf = document.getElementById('under-pdf');
  var frontCanvas = document.getElementById('front-canvas');
  var underCanvas = document.getElementById('under-canvas');
  var frontFolio = document.getElementById('front-folio');
  var underFolio = document.getElementById('under-folio');
  var motion = 0;

  function post(message) {
    message.source = 'bookshelf';
    var raw = JSON.stringify(message);
    if (window.ReactNativeWebView && window.ReactNativeWebView.postMessage) {
      window.ReactNativeWebView.postMessage(raw);
    } else if (window.parent) {
      window.parent.postMessage(raw, '*');
    }
  }

  function readSettings(raw) {
    raw = raw || {};
    var legacy = !!raw.verticalTraditional;
    function num(value, min, max, fallback) {
      var n = Number(value);
      if (!isFinite(n)) return fallback;
      return Math.min(max, Math.max(min, n));
    }
    var align = raw.align === 'left' || raw.align === 'center' || raw.align === 'justify' ? raw.align : 'justify';
    return {
      fontId: raw.fontId && FONTS[raw.fontId] ? raw.fontId : 'system',
      fontSize: Math.round(num(raw.fontSize, 14, 36, 20)),
      lineHeight: Math.round(num(raw.lineHeight, 1.35, 2.3, 1.7) * 100) / 100,
      margin: Math.round(num(raw.margin, 8, 48, 22)),
      align: align,
      theme: raw.theme && THEMES[raw.theme] ? raw.theme : 'sepia',
      vertical: typeof raw.vertical === 'boolean' ? raw.vertical : legacy,
      traditional: typeof raw.traditional === 'boolean' ? raw.traditional : legacy,
      brightness: num(raw.brightness, 0.55, 1, 1)
    };
  }

  function setInsets(raw) {
    raw = raw || {};
    function edge(value) {
      var n = Number(value);
      return isFinite(n) && n > 0 ? n : 0;
    }
    state.insets = { top: edge(raw.top), right: edge(raw.right), bottom: edge(raw.bottom), left: edge(raw.left) };
    var root = document.documentElement.style;
    root.setProperty('--safe-top', state.insets.top + 'px');
    root.setProperty('--safe-right', state.insets.right + 'px');
    root.setProperty('--safe-bottom', state.insets.bottom + 'px');
    root.setProperty('--safe-left', state.insets.left + 'px');
  }

  function applyTheme() {
    var theme = THEMES[state.settings.theme] || THEMES.sepia;
    var font = FONTS[state.settings.fontId] || FONTS.system;
    if (state.settings.vertical && state.settings.fontId === 'system') font = FONTS.songti;
    if (state.settings.traditional) {
      font = '"PingFang TC", "Songti TC", "Heiti TC", "Kaiti TC", "Yuanti TC", ' + font;
    }
    var root = document.documentElement;
    root.lang = state.settings.traditional ? 'zh-Hant' : 'zh-Hans';
    root.classList.toggle('traditional', !!state.settings.traditional);
    var style = root.style;
    style.setProperty('--paper', theme.paper);
    style.setProperty('--ink', theme.ink);
    style.setProperty('--font', font);
    style.setProperty('--fs', state.settings.fontSize + 'px');
    style.setProperty('--lh', String(state.settings.lineHeight));
    style.setProperty('--align', state.settings.align);
    style.setProperty('--margin', state.settings.margin + 'px');
    document.body.style.background = theme.paper;
    var vertical = isVertical();
    leaf.classList.toggle('vertical', vertical);
    under.classList.toggle('vertical', vertical);
    measure.classList.toggle('vertical', vertical);
  }

  var bootNote = null;
  function armBootNote() {
    if (bootNote) clearTimeout(bootNote);
    bootNote = setTimeout(function () {
      if (stage.classList.contains('shown')) return;
      statusEl.textContent = state.kind === 'pdf' ? '正在渲染 PDF…' : '正在排版…';
      statusEl.style.display = 'flex';
    }, 240);
  }
  function revealInk() {
    if (bootNote) clearTimeout(bootNote);
    statusEl.style.display = 'none';
    stage.classList.remove('booting');
    stage.classList.add('shown');
  }

  function isVertical() {
    return !!(state.settings.vertical && state.kind !== 'pdf');
  }

  function contentBox() {
    var pad = leaf.querySelector('.pad');
    return { w: pad.clientWidth || (stage.clientWidth - 52), h: pad.clientHeight || (stage.clientHeight - 64) };
  }

  function overflows(el) {
    var probe = el.querySelector ? el.querySelector('.probe') : null;
    var node = probe || el;
    var box = contentBox();
    if (isVertical()) return node.scrollWidth > box.w + 2;
    return node.scrollHeight > box.h + 2;
  }

  function readableHtml(html) {
    var parsed = null;
    try { parsed = new DOMParser().parseFromString(String(html || ''), 'text/html'); } catch (err) { parsed = null; }
    if (!parsed || !parsed.body) return '<p class="empty">这一章没有正文。</p>';
    var styles = [];
    parsed.querySelectorAll('style').forEach(function (node) { styles.push(node.textContent || ''); });
    var body = parsed.body.cloneNode(true);
    body.querySelectorAll('style,script,link,meta,iframe,object').forEach(function (node) { node.remove(); });
    var text = (body.textContent || '').replace(/\s+/g, '');
    if (!text && !body.querySelector('img,svg,canvas,table')) return '<p class="empty">这一章没有正文。</p>';
    return (styles.length ? '<style>' + styles.join('\n') + '</style>' : '') + body.innerHTML;
  }

  function pageIsBlank(html) {
    var holder = document.createElement('div');
    holder.innerHTML = html || '';
    holder.querySelectorAll('style,script').forEach(function (node) { node.remove(); });
    return !(holder.textContent || '').replace(/\s+/g, '') && !holder.querySelector('img,svg,canvas,table');
  }

  function isCjk(html) {
    return /[\u3400-\u9fff\uf900-\ufaff]/.test(String(html || ''));
  }

  function tagParas(root) {
    var nodes = root.querySelectorAll('p, div, li, blockquote');
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      if (el.querySelector('p, div, ul, ol, table, blockquote, h1, h2, h3, h4, figure')) continue;
      var text = (el.textContent || '').replace(/\s+/g, '');
      if (!text && !el.querySelector('img, svg, canvas')) continue;
      var hint = (el.getAttribute('align') || '') + ' ' + (el.getAttribute('style') || '') + ' ' + String(el.className || '');
      el.classList.add(/center/i.test(hint) ? 'para-center' : 'para');
    }
  }

  function proseClass(html) {
    return 'prose' +
      (isCjk(html) ? ' cjk' : '') +
      (state.settings.align === 'center' ? ' align-center' : '') +
      (state.settings.vertical ? ' vertical' : '');
  }

  function paginate(html) {
    html = readableHtml(html);
    var sandboxEarly = document.createElement('div');
    sandboxEarly.innerHTML = html || '<p class="empty">这一章没有正文。</p>';
    tagParas(sandboxEarly);
    html = sandboxEarly.innerHTML;
    var box = contentBox();
    if (box.w < 48 || box.h < 48) return [html];
    measure.style.width = box.w + 'px';
    measure.style.height = state.settings.vertical ? box.h + 'px' : 'auto';
    measure.className = proseClass(html);
    var sandbox = document.createElement('div');
    sandbox.innerHTML = html || '<p class="empty">这一章没有正文。</p>';
    tagParas(sandbox);
    var nodes = Array.prototype.slice.call(sandbox.childNodes);
    var pages = [];
    var page = document.createElement('div');
    page.className = 'probe';
    measure.innerHTML = '';
    measure.appendChild(page);

    function commitPage() {
      pages.push(page.innerHTML);
      page = document.createElement('div');
      page.className = 'probe';
      measure.innerHTML = '';
      measure.appendChild(page);
    }

    function maxFit(el, text) {
      var lo = 1, hi = text.length, best = 0;
      while (lo <= hi) {
        var mid = (lo + hi) >> 1;
        el.textContent = text.slice(0, mid);
        page.appendChild(el);
        var over = overflows(measure);
        page.removeChild(el);
        if (!over) { best = mid; lo = mid + 1; }
        else hi = mid - 1;
      }
      return best;
    }

    function splitNode(node) {
      var source = node;
      if (source.nodeType === 3) {
        var span = document.createElement('span');
        span.textContent = source.textContent;
        source = span;
      }
      if (source.nodeType !== 1) return [source];
      var text = source.textContent || '';
      if (text.length < 2) return [source];
      var pieces = [];
      var rest = text;
      var guard = 0;
      while (rest.length && guard < 100) {
        guard += 1;
        var el = source.cloneNode(false);
        var fit = maxFit(el, rest);
        if (fit <= 0) fit = 1;
        var cut = fit;
        var windowStart = Math.max(0, fit - 24);
        var slice = rest.slice(windowStart, fit);
        var broken = slice.search(/[。！？；\n，、]/);
        if (broken >= 0 && windowStart + broken + 1 >= 8) cut = windowStart + broken + 1;
        el.textContent = rest.slice(0, cut);
        pieces.push(el);
        rest = rest.slice(cut).replace(/^\s+/, '');
      }
      return pieces.length ? pieces : [source];
    }

    nodes.forEach(function (node) {
      if (node.nodeType === 3 && !(node.textContent || '').trim()) return;
      if (node.nodeType === 1 && /^(STYLE|SCRIPT|LINK|META)$/.test(node.tagName)) return;
      page.appendChild(node);
      if (!overflows(measure)) return;
      page.removeChild(node);
      if (page.childNodes.length) commitPage();
      var pieces = splitNode(node);
      pieces.forEach(function (piece) {
        page.appendChild(piece);
        if (overflows(measure)) {
          page.removeChild(piece);
          if (page.childNodes.length) commitPage();
          page.appendChild(piece);
        }
      });
    });
    if (!page.childNodes.length && pages.length === 0) pages.push('<p class="empty">这一章没有正文。</p>');
    else if (page.childNodes.length) pages.push(page.innerHTML);
    measure.innerHTML = '';
    pages = pages.filter(function (item) { return !pageIsBlank(item); });
    return pages.length ? pages : ['<p class="empty">这一章没有正文。</p>'];
  }

  function layoutStamp() {
    var box = contentBox();
    var s = state.settings;
    return [s.fontId, s.fontSize, s.lineHeight, s.margin, s.align, s.vertical ? 'v' : 'h', box.w, box.h].join(':');
  }

  function pagesFor(chapter) {
    var key = chapter + ':' + layoutStamp();
    if (state.cache[key]) return state.cache[key];
    var chapterData = state.chapters[chapter];
    var html = chapterData ? ((chapterData.styles ? '<style>' + chapterData.styles + '</style>' : '') + chapterData.html) : '';
    var pages = paginate(html);
    state.cache[key] = pages;
    return pages;
  }

  function bookProgress(chapter, page, pageCount, chapterCount) {
    if (chapterCount <= 0) return 0;
    var pages = Math.max(pageCount, 1);
    var chapterIndex = Math.max(0, Math.min(chapter, chapterCount - 1));
    var pageIndex = Math.max(0, Math.min(page, pages - 1));
    var last = chapterIndex >= chapterCount - 1 && pageIndex >= pages - 1;
    if (last && (chapterCount > 1 || pages > 1)) return 1;
    if (chapterIndex === 0 && pageIndex === 0) return 0;
    return Math.max(0, Math.min(1, (chapterIndex + pageIndex / pages) / chapterCount));
  }

  function report() {
    var pageCount = state.kind === 'pdf' && state.pdf ? state.pdf.numPages : (state.kind === 'html' ? pagesFor(state.chapter).length : 1);
    var chapterCount = state.kind === 'pdf' ? 1 : Math.max(state.chapters.length, 1);
    var title = state.kind === 'pdf' ? '' : ((state.chapters[state.chapter] && state.chapters[state.chapter].title) || '');
    post({
      type: 'progress',
      chapterIndex: state.chapter,
      pageIndex: state.page,
      pageCount: pageCount,
      chapterCount: chapterCount,
      progress: bookProgress(state.chapter, state.page, pageCount, chapterCount),
      chapterTitle: title
    });
  }

  function setHtml(target, folio, html, pageNumber, pageCount) {
    target.hidden = false;
    var wrap = target.parentElement.querySelector('.pdfwrap');
    if (wrap) wrap.hidden = true;
    target.className = proseClass(html);
    target.innerHTML = html;
    folio.textContent = pageCount > 1 ? String(pageNumber + 1) : '';
  }

  function showHtml(chapter, page, underPage) {
    state.kind = 'html';
    var pages = pagesFor(chapter);
    var index = Math.max(0, Math.min(pages.length - 1, page));
    state.chapter = chapter;
    state.page = index;
    frontPdf.hidden = true;
    underPdf.hidden = true;
    frontHtml.hidden = false;
    underHtml.hidden = false;
    setHtml(frontHtml, frontFolio, pages[index], index, pages.length);
    var next = underPage;
    if (!next) {
      if (index + 1 < pages.length) next = { chapter: chapter, page: index + 1 };
      else if (chapter + 1 < state.chapters.length) next = { chapter: chapter + 1, page: 0 };
      else next = { chapter: chapter, page: index };
    }
    var neighborPages = pagesFor(next.chapter);
    var neighborIndex = Math.max(0, Math.min(neighborPages.length - 1, next.page));
    setHtml(underHtml, underFolio, neighborPages[neighborIndex] || '', neighborIndex, neighborPages.length);
    revealInk();
    if ((stage.clientWidth < 48 || stage.clientHeight < 48) && (state.layoutTries || 0) < 8) {
      state.layoutTries = (state.layoutTries || 0) + 1;
      setTimeout(function () {
        state.cache = {};
        if (state.kind === 'html') showHtml(state.chapter, state.page, null);
      }, 80);
    } else if (stage.clientHeight >= 48) {
      state.layoutTries = 0;
    }
    report();
  }

  function neighbor(dir) {
    if (state.kind === 'pdf') {
      var count = state.pdf ? state.pdf.numPages : 1;
      var page = state.page + dir;
      if (page < 0 || page >= count) return null;
      return { chapter: 0, page: page };
    }
    var pages = pagesFor(state.chapter);
    var page = state.page + dir;
    if (page >= 0 && page < pages.length) return { chapter: state.chapter, page: page };
    var chapter = state.chapter + dir;
    if (chapter < 0 || chapter >= state.chapters.length) return null;
    var other = pagesFor(chapter);
    return { chapter: chapter, page: dir > 0 ? 0 : Math.max(0, other.length - 1) };
  }

  function paintUnder(dest) {
    if (!dest) return;
    if (state.kind === 'pdf') {
      underPdf.hidden = false;
      underHtml.hidden = true;
      renderPdf(dest.page + 1, underCanvas);
      underFolio.textContent = String(dest.page + 1);
      return;
    }
    var pages = pagesFor(dest.chapter);
    var index = Math.max(0, Math.min(pages.length - 1, dest.page));
    underHtml.hidden = false;
    underPdf.hidden = true;
    setHtml(underHtml, underFolio, pages[index] || '', index, pages.length);
  }

  function setLeafX(x) {
    if (Math.abs(x) < 0.5) {
      leaf.style.transform = 'none';
      leaf.style.webkitTransform = 'none';
      leaf.style.willChange = 'auto';
      leaf.style.boxShadow = 'none';
      return;
    }
    var value = 'translate3d(' + Math.round(x) + 'px,0,0)';
    leaf.style.willChange = 'transform';
    leaf.style.transform = value;
    leaf.style.webkitTransform = value;
    leaf.style.boxShadow = '0 0 18px rgba(40, 24, 10, 0.12)';
  }

  function paintEdge(amount, dir) {
    var value = amount <= 0.01 ? '0' : String(Math.max(0, Math.min(0.9, amount)));
    edgeRight.style.opacity = dir > 0 ? value : '0';
    edgeLeft.style.opacity = dir > 0 ? '0' : value;
  }

  function restLeaf() {
    motion += 1;
    setLeafX(0);
    paintEdge(0, 1);
    leaf.style.transformStyle = 'flat';
    leaf.style.webkitTransformStyle = 'flat';
  }

  function commit(dest) {
    motion += 1;
    if (!dest) {
      restLeaf();
      if (state.kind === 'pdf') renderPdf(state.page + 1, frontCanvas);
      else showHtml(state.chapter, state.page, null);
      return;
    }
    if (state.kind === 'pdf') {
      state.page = dest.page;
      if (underCanvas.width > 0 && underCanvas.height > 0) {
        frontCanvas.width = underCanvas.width;
        frontCanvas.height = underCanvas.height;
        frontCanvas.style.width = underCanvas.style.width;
        frontCanvas.style.height = underCanvas.style.height;
        var ctx = frontCanvas.getContext('2d');
        if (ctx) ctx.drawImage(underCanvas, 0, 0);
      } else {
        renderPdf(state.page + 1, frontCanvas);
      }
      frontFolio.textContent = String(state.page + 1);
      frontHtml.hidden = true;
      underHtml.hidden = true;
      frontPdf.hidden = false;
      underPdf.hidden = false;
      setLeafX(0);
      paintEdge(0, 1);
      leaf.style.transformStyle = 'flat';
      leaf.style.webkitTransformStyle = 'flat';
      var nxt = neighbor(1);
      if (nxt) renderPdf(nxt.page + 1, underCanvas);
      report();
      return;
    }
    var landed = pagesFor(dest.chapter);
    var landedIndex = Math.max(0, Math.min(landed.length - 1, dest.page));
    state.chapter = dest.chapter;
    state.page = landedIndex;
    frontPdf.hidden = true;
    underPdf.hidden = true;
    frontHtml.hidden = false;
    underHtml.hidden = false;
    setHtml(frontHtml, frontFolio, landed[landedIndex], landedIndex, landed.length);
    setLeafX(0);
    paintEdge(0, 1);
    leaf.style.transformStyle = 'flat';
    leaf.style.webkitTransformStyle = 'flat';
    var follow = neighbor(1);
    if (follow) paintUnder(follow);
    revealInk();
    report();
  }

  // Each frame writes translate3d only. A perspective fold repaints the WebView and drops frames.
  function glideLeaf(from, to, dir, done) {
    var token = ++motion;
    var began = performance.now();
    var duration = 260;
    var finished = false;
    function finish() {
      if (finished || token !== motion) return;
      finished = true;
      setLeafX(to);
      done();
    }
    function step(now) {
      if (finished || token !== motion) return;
      var t = Math.min(1, (now - began) / duration);
      var eased = 1 - Math.pow(1 - t, 3);
      var x = from + (to - from) * eased;
      setLeafX(x);
      paintEdge(Math.abs(x) / Math.max(stage.clientWidth, 1), dir);
      if (t < 1) requestAnimationFrame(step);
      else finish();
    }
    requestAnimationFrame(step);
    setTimeout(finish, duration + 50);
  }

  function renderPdf(pageNumber, canvas) {
    if (!state.pdf) return Promise.resolve();
    return state.pdf.getPage(pageNumber).then(function (page) {
      var wrap = canvas.parentElement;
      var maxW = wrap.clientWidth || stage.clientWidth - 48;
      var maxH = wrap.clientHeight || stage.clientHeight - 64;
      var dpr = Math.min(window.devicePixelRatio || 1, 3);
      var base = page.getViewport({ scale: 1 });
      var fit = Math.min(maxW / base.width, maxH / base.height);
      if (!isFinite(fit) || fit <= 0) fit = 1;
      var viewport = page.getViewport({ scale: fit * dpr });
      canvas.width = Math.floor(viewport.width);
      canvas.height = Math.floor(viewport.height);
      canvas.style.width = Math.floor(viewport.width / dpr) + 'px';
      canvas.style.height = Math.floor(viewport.height / dpr) + 'px';
      var context = canvas.getContext('2d');
      return page.render({ canvasContext: context, viewport: viewport }).promise.then(function () {
        if (!state.coverSent && pageNumber === 1) {
          state.coverSent = true;
          try {
            var thumb = document.createElement('canvas');
            thumb.width = 240;
            thumb.height = Math.max(1, Math.round(240 * (canvas.height / Math.max(canvas.width, 1))));
            var ctx = thumb.getContext('2d');
            var paper = (THEMES[state.settings.theme] || THEMES.sepia).paper;
            ctx.fillStyle = paper;
            ctx.fillRect(0, 0, thumb.width, thumb.height);
            ctx.drawImage(canvas, 0, 0, thumb.width, thumb.height);
            post({ type: 'cover', dataUrl: thumb.toDataURL('image/jpeg', 0.82) });
          } catch (err) {}
        }
      });
    });
  }

  function openPdf(bytes) {
    var workerNode = document.getElementById('pdf-worker');
    var workerCode = workerNode ? workerNode.textContent : '';
    if (window.pdfjsLib && workerCode) {
      var blob = new Blob([workerCode], { type: 'text/javascript' });
      window.pdfjsLib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(blob);
    }
    armBootNote();
    return window.pdfjsLib.getDocument({ data: bytes }).promise.then(function (doc) {
      state.pdf = doc;
      state.kind = 'pdf';
      state.chapter = 0;
      state.page = Math.max(0, Math.min(doc.numPages - 1, state.page || 0));
      frontHtml.hidden = true;
      underHtml.hidden = true;
      frontPdf.hidden = false;
      underPdf.hidden = false;
      return renderPdf(state.page + 1, frontCanvas).then(function () {
        var nxt = neighbor(1);
        if (nxt) return renderPdf(nxt.page + 1, underCanvas);
      }).then(function () {
        frontFolio.textContent = String(state.page + 1);
        revealInk();
        report();
      });
    }).catch(function (error) {
      statusEl.style.display = 'flex';
      statusEl.textContent = 'PDF 无法打开';
      post({ type: 'error', message: error && error.message ? error.message : 'PDF 无法打开' });
    });
  }

  function b64ToBytes(b64) {
    var bin = atob(b64);
    var out = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
  }

  function loadBook(message) {
    state.cache = {};
    state.coverSent = false;
    if (message.insets) setInsets(message.insets);
    state.settings = readSettings(message.settings || state.settings);
    applyTheme();
    var position = message.position || { chapterIndex: 0, pageIndex: 0 };
    state.chapter = position.chapterIndex || 0;
    state.page = position.pageIndex || 0;
    if (message.book && message.book.kind === 'html') {
      state.kind = 'html';
      state.chapters = message.book.chapters || [];
      if (state.chapter >= state.chapters.length) state.chapter = 0;
      armBootNote();
      showHtml(state.chapter, state.page, neighbor(1));
      return;
    }
    if (message.book && message.book.kind === 'pdf' && message.book.pdfBase64) {
      state.kind = 'pdf';
      openPdf(b64ToBytes(message.book.pdfBase64));
    }
  }

  function gotoProgress(progress) {
    var p = Math.max(0, Math.min(0.999, progress));
    if (state.kind === 'pdf' && state.pdf) {
      var page = Math.min(state.pdf.numPages - 1, Math.floor(p * state.pdf.numPages));
      commit({ chapter: 0, page: page });
      return;
    }
    var count = Math.max(state.chapters.length, 1);
    var scaled = p * count;
    var chapter = Math.min(count - 1, Math.floor(scaled));
    var pages = pagesFor(chapter);
    var page = Math.min(pages.length - 1, Math.floor((scaled - chapter) * pages.length));
    commit({ chapter: chapter, page: page });
  }

  function reflow(fraction) {
    state.cache = {};
    applyTheme();
    if (state.kind === 'html') {
      var pages = pagesFor(state.chapter);
      showHtml(state.chapter, Math.round(fraction * Math.max(pages.length - 1, 0)), neighbor(1));
    } else if (state.kind === 'pdf') {
      renderPdf(state.page + 1, frontCanvas);
    }
  }

  function onMessage(event) {
    var data = event.data;
    if (typeof data === 'string') {
      try { data = JSON.parse(data); } catch (err) { return; }
    }
    if (!data || !data.type) return;
    if (data.type === 'hello') post({ type: 'ready' });
    if (data.type === 'load') loadBook(data);
    if (data.type === 'settings') {
      var fraction = 0;
      if (state.kind === 'html') {
        var current = pagesFor(state.chapter);
        fraction = current.length ? state.page / current.length : 0;
      }
      var before = layoutStamp();
      state.settings = readSettings(data.settings || state.settings);
      applyTheme();
      if (layoutStamp() !== before) reflow(fraction);
    }
    if (data.type === 'insets') {
      var insetFraction = 0;
      if (state.kind === 'html') {
        var insetPages = pagesFor(state.chapter);
        insetFraction = insetPages.length ? state.page / insetPages.length : 0;
      }
      var insetBefore = layoutStamp();
      setInsets(data);
      if (layoutStamp() !== insetBefore) reflow(insetFraction);
    }
    if (data.type === 'goto') {
      if (typeof data.progress === 'number') gotoProgress(data.progress);
      else commit({ chapter: data.chapterIndex || 0, page: data.pageIndex || 0 });
    }
    if (data.type === 'pdf-begin') {
      state.pdfChunks = [];
      state.pending = data;
    }
    if (data.type === 'pdf-chunk' && typeof data.data === 'string') state.pdfChunks.push(data.data);
    if (data.type === 'pdf-end' && state.pending) {
      var assembled = state.pending;
      assembled.book = { kind: 'pdf', pdfBase64: state.pdfChunks.join('') };
      state.pdfChunks = [];
      loadBook(assembled);
    }
  }

  window.addEventListener('message', onMessage);
  document.addEventListener('message', onMessage);

  function offsetFor(dir, distance) {
    return dir > 0 ? -distance : distance;
  }

  function dirFromDx(dx) {
    if (dx < -1) return 1;
    if (dx > 1) return -1;
    return 0;
  }

  var drag = null;
  stage.addEventListener('pointerdown', function (event) {
    if (state.busy) return;
    drag = {
      x: event.clientX,
      y: event.clientY,
      t: performance.now(),
      moved: false,
      lx: event.clientX,
      lt: performance.now(),
      vx: 0,
      offset: 0,
      dir: 0,
      painted: false
    };
  });
  window.addEventListener('pointermove', function (event) {
    if (!drag || state.busy) return;
    var dx = event.clientX - drag.x;
    var dy = event.clientY - drag.y;
    if (!drag.moved && (Math.abs(dx) < 8 || Math.abs(dx) < Math.abs(dy))) return;
    drag.moved = true;
    var dir = dirFromDx(dx) || drag.dir || 1;
    drag.dir = dir;
    var dest = neighbor(dir);
    var width = Math.max(stage.clientWidth, 1);
    var x = dest ? Math.max(-width, Math.min(width, dx)) : dx * 0.2;
    if (dest && (!drag.painted || drag.paintedDir !== dir)) {
      drag.painted = true;
      drag.paintedDir = dir;
      paintUnder(dest);
    }
    drag.offset = x;
    setLeafX(x);
    paintEdge(Math.min(1, Math.abs(x) / width), dir);
    var now = performance.now();
    var dt = Math.max(1, now - drag.lt);
    drag.vx = (event.clientX - drag.lx) / dt;
    drag.lx = event.clientX;
    drag.lt = now;
  });
  function endDrag(event) {
    if (!drag) return;
    var dx = event.clientX - drag.x;
    var width = Math.max(stage.clientWidth, 1);
    var start = drag;
    drag = null;
    if (!start.moved) {
      var x = start.x / width;
      var vertical = isVertical();
      if (vertical ? x < 0.22 : x > 0.78) turn(1);
      else if (vertical ? x > 0.78 : x < 0.22) turn(-1);
      else {
        post({ type: 'chrome' });
        restLeaf();
      }
      return;
    }
    var dir = dirFromDx(dx) || start.dir || 1;
    var dest = neighbor(dir);
    var flick = start.vx || 0;
    var should = !!(dest && (Math.abs(dx) > width * 0.18 || Math.abs(flick) > 0.55));
    var from = start.offset || 0;
    if (!should) {
      state.busy = true;
      glideLeaf(from, 0, dir, function () {
        state.busy = false;
        restLeaf();
      });
      return;
    }
    state.busy = true;
    glideLeaf(from, offsetFor(dir, width), dir, function () {
      state.busy = false;
      commit(dest);
    });
  }
  window.addEventListener('pointerup', endDrag);
  window.addEventListener('pointercancel', endDrag);

  function turn(dir) {
    var dest = neighbor(dir);
    if (!dest || state.busy) return;
    paintUnder(dest);
    state.busy = true;
    var width = Math.max(stage.clientWidth, 1);
    glideLeaf(0, offsetFor(dir, width), dir, function () {
      state.busy = false;
      commit(dest);
    });
  }

  window.addEventListener('keydown', function (event) {
    if (event.key === 'ArrowRight' || event.key === 'PageDown') turn(isVertical() ? -1 : 1);
    if (event.key === 'ArrowLeft' || event.key === 'PageUp') turn(isVertical() ? 1 : -1);
  });
  window.addEventListener('resize', function () {
    restLeaf();
    if (state.kind === 'html') {
      state.cache = {};
      showHtml(state.chapter, state.page, neighbor(1));
    } else if (state.kind === 'pdf') {
      renderPdf(state.page + 1, frontCanvas);
    }
  });

  armBootNote();
  post({ type: 'ready' });
})();
</script>
</body>
</html>
